<Application x:Class="Gtools.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#FF501F"/>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,7"/><Setter Property="Margin" Value="3"/>
        </Style>
        <Style TargetType="TextBox"><Setter Property="Padding" Value="7"/><Setter Property="Margin" Value="3"/></Style>
    </Application.Resources>
</Application>
